# wifi_secrets.py.example — copy this file to wifi_secrets.py on the Pico
# (via Thonny, File -> Save As -> Raspberry Pi Pico -> filename "wifi_secrets.py")
# and fill in your real values. wifi_secrets.py itself is gitignored, so
# your real WiFi password never ends up in this repo — only this
# placeholder template does.
#
# main.py automatically switches to WiFi mode if it finds wifi_secrets.py
# on the Pico's filesystem, and falls back to USB serial if it doesn't —
# so to go back to USB, just delete wifi_secrets.py from the Pico.

WIFI_SSID = "your-wifi-name"
WIFI_PASSWORD = "your-wifi-password"

# Your laptop's local IP address on the same WiFi network (check with
# `ipconfig` on Windows — look for "IPv4 Address" under the WiFi adapter).
# This can change if your laptop reconnects to WiFi, so update it here if
# the wireless link stops connecting.
LAPTOP_HOST = "192.168.1.100"
LAPTOP_PORT = 5005
