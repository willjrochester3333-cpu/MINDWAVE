# ble_secrets.py.example — copy this file to ble_secrets.py on the Pico
# (via Thonny, File -> Save As -> Raspberry Pi Pico -> filename "ble_secrets.py")
# to enable Bluetooth (BLE) mode.
#
# main.py checks for connection config in this order:
#   1. ble_secrets.py  -> Bluetooth (BLE)
#   2. wifi_secrets.py -> WiFi
#   3. neither present -> USB serial
# Only keep the one you actually want to use on the Pico at a time —
# delete the others (or just don't save them).
#
# Unlike WiFi, Bluetooth needs no password/IP — the Pico just advertises
# itself under this name and mindwave_pico_bridge.py --link bluetooth
# scans for it.

BLE_NAME = "MindWave"
